# BLIND SPOT - Environment Configuration
# If no keys are provided, the application will automatically run in Demo Fallback Mode!

# Port for standalone server (default: 3001)
PORT=3001

# AI Provider API Keys (Optional - Fallback Mode will engage seamlessly if absent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative: Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Alternative: Anthropic API Key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Alternative: Groq API Key
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
